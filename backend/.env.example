# Backend Environment Template - Copy to backend/.env (never commit .env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
ALLOW_LIVE_AI=true
AI_RUN_COOLDOWN_SECONDS=30

# Production paid-tier pricing assumptions (USD per 1M tokens) for pilot cost estimation only (:free tier is $0)
MODEL_PRICE_INPUT_PER_M_USD=0.30
MODEL_PRICE_OUTPUT_PER_M_USD=2.50

DATABASE_URL=sqlite:///./triage.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=262144
SNAPSHOT_TIME_IST=2026-11-23 09:00

