# EzyHelpers AI Operations Triage - Environment Template
# Copy to backend/.env (never commit actual secrets)

# OpenRouter (backend only - NEVER expose to frontend)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
ALLOW_LIVE_AI=true
AI_RUN_COOLDOWN_SECONDS=30

# Production paid-tier pricing assumptions (USD per 1M tokens, e.g. gemini-2.5-flash)
# used ONLY for pilot cost estimation when the provider returns no cost (:free models are $0)
MODEL_PRICE_INPUT_PER_M_USD=0.30
MODEL_PRICE_OUTPUT_PER_M_USD=2.50

# Database (SQLite locally; PostgreSQL connection string in production)
DATABASE_URL=sqlite:///./triage.db

# CORS & Upload Limits
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=262144
SNAPSHOT_TIME_IST=2026-11-23 09:00

# Frontend public API base URL (safe to expose; contains no secrets)
NEXT_PUBLIC_API_URL=http://localhost:8000

